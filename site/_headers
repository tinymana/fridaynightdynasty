# Read by Cloudflare Pages and Netlify.
# Art, fonts and icons rarely change: cache them for a day.
/assets/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Pages, the game build and dev notes: always check for a newer version.
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/play/*
  Cache-Control: no-cache
/devnotes.json
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
