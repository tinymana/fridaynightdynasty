{
  "name": "friday-night-dynasty",
  "private": true,
  "version": "0.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx tools/headless.ts",
    "check:browser": "node tools/browser-check.mjs",
    "build:site": "vite build && cp dist/index.html site/play/index.html",
    "check:ui": "node tools/ui-check.mjs",
    "probe": "tsx tools/probe.ts",
    "bundle:function": "esbuild supabase/functions/fnd/index.ts --bundle --format=esm --platform=neutral --target=es2022 \"--external:npm:*\" --minify --legal-comments=none --outfile=supabase/functions/fnd/dist/index.js",
    "mock:online": "tsx tools/mock-online.ts",
    "check:online": "node tools/online-check.mjs",
    "check:voice": "node tools/voice-check.mjs",
    "check:designer": "node tools/designer-check.mjs",
    "check:dynasty": "node tools/dynasty-check.mjs",
    "check:league": "node tools/league-check.mjs"
  },
  "devDependencies": {
    "@fontsource/jersey-15": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@types/node": "^26.6.10",
    "esbuild": "^0.28.2",
    "phaser": "^3.90.0",
    "puppeteer-core": "^25.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.2"
  }
}
