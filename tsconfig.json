{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "paths": {
      "@fnd/core": ["./packages/core/src/index.ts"],
      "@fnd/football-ai": ["./packages/football-ai/src/index.ts"],
      "@fnd/match-sim": ["./packages/match-sim/src/index.ts"]
    }
  },
  "include": ["packages", "apps", "tools", "tests", "vite.config.ts"]
}
